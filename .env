# App General Config (de Config class)
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO  # DEBUG para dev, INFO para prod

# CORS Config (para middleware en main.py; * para dev, restringe en prod)
CORS_ALLOW_ORIGIN=*  # e.g., http://localhost:3000,https://yourapp.com
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# Postgres DB (de PostgresConfig; low-cost: Usa Supabase/Neon free con HOST=yourdb.supabase.co, SSL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pdf_processor
POSTGRES_USER=pdfuser
POSTGRES_PASSWORD=pdfpass123  # Cambia a strong password; usa env vars en prod


DATABASE_URL=postgresql+asyncpg://pdfuser:pdfpass123@localhost/pdf_processor
ENVIRONMENT=development

# Opcional: Para IA/Features Futuras (e.g., resúmenes con OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here  # Si agregas IA en services

# Opcional: Uvicorn Workers (para prod: gunicorn -w $WORKERS -k uvicorn.workers.UvicornWorker main:app)
WORKERS=1  # Aumenta a CPU cores en server